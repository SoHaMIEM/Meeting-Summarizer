# Meeting Summarizer Environment Configuration
# 
# IMPORTANT: This is a template file. Create a copy as .env and fill in your actual values.
# Never commit your actual .env file with real credentials to version control.

# =============================================================================
# GEMINI AI CONFIGURATION
# =============================================================================
# Get your API key from https://makersuite.google.com/app/apikey
# Instructions:
# 1. Go to Google AI Studio (https://makersuite.google.com/app/apikey)
# 2. Sign in with your Google account
# 3. Create a new API key
# 4. Copy the key below
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# For sending summary emails. Gmail is recommended.
# 
# SECURITY NOTE: Use App Passwords, not your regular password!
# Setup instructions for Gmail:
# 1. Enable 2-factor authentication on your Gmail account
# 2. Go to Google Account settings > Security > 2-Step Verification > App passwords
# 3. Generate password for "Mail" 
# 4. Use the 16-character app password below (not your regular password)

EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_16_character_app_password_here

# SMTP Configuration (Gmail defaults - change if using different provider)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# =============================================================================
# FLASK CONFIGURATION
# =============================================================================
# Development settings
FLASK_ENV=development
FLASK_DEBUG=True

# =============================================================================
# OPTIONAL: Alternative Email Providers
# =============================================================================
# Uncomment and modify if using different email provider:

# Outlook/Hotmail:
# SMTP_SERVER=smtp-mail.outlook.com
# SMTP_PORT=587

# Yahoo:
# SMTP_SERVER=smtp.mail.yahoo.com
# SMTP_PORT=587

# Custom SMTP:
# SMTP_SERVER=your-smtp-server.com
# SMTP_PORT=587
